package {
    default_applicable_licenses: ["vendor_intel_hardware_interfaces_license"],
}

license {
    name: "vendor_intel_hardware_interfaces_license",
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
}

// ============================================================
// Thermal AIDL Interface (already AIDL in BlissOS, update for AOSP 17)
// ============================================================
// Defined in thermal/aidl/Android.bp

// Thermal AIDL implementation
cc_library_shared {
    name: "android.hardware.thermal.intel-impl",
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "thermal/aidl/default/Thermal.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libutils",
        "android.hardware.thermal.intel-V2-ndk",
    ],
    cflags: [
        "-Werror",
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    compile_multilib: "64",
    arch: {
        arm64: {
            enabled: false,
        },
    },
}

cc_binary {
    name: "android.hardware.thermal.intel-service",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["thermal/aidl/default/android.hardware.thermal.intel-service.rc"],
    vintf_fragments: ["thermal/aidl/default/android.hardware.thermal.intel-service.xml"],
    srcs: ["thermal/aidl/default/main.cpp"],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "android.hardware.thermal.intel-V2-ndk",
        "android.hardware.thermal.intel-impl",
    ],
    cflags: [
        "-Werror",
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    compile_multilib: "64",
    arch: {
        arm64: {
            enabled: false,
        },
    },
}

prebuilt_etc {
    name: "android.hardware.thermal.intel-service.rc",
    src: "thermal/aidl/default/android.hardware.thermal@aidl-service.intel.rc",
    sub_dir: "etc/init",
    vendor: true,
}

prebuilt_etc {
    name: "android.hardware.thermal.intel-service.xml",
    src: "thermal/aidl/default/android.hardware.thermal@aidl-intel.xml",
    sub_dir: "etc/vintf/manifest",
    vendor: true,
}

// ============================================================
// Health AIDL Interface (migrate from HIDL 2.1)
// ============================================================
// Defined in health/aidl/Android.bp

// Health AIDL implementation
cc_library_shared {
    name: "android.hardware.health.intel-impl",
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "health/aidl/default/HealthImpl.cpp",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "libutils",
        // "android.hardware.health.intel-V1-ndk",  // Commented out temporarily
    ],
    static_libs: [
        "libbatterymonitor",
        "libhealthloop.intel",
        "libhealthd.intel",
        "libfstab",
    ],
    cflags: [
        "-Werror",
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    compile_multilib: "64",
    arch: {
        arm64: {
            enabled: false,
        },
    },
}

cc_binary {
    name: "android.hardware.health.intel-service",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["health/aidl/default/android.hardware.health.intel-service.rc"],
    vintf_fragments: ["health/aidl/default/android.hardware.health.intel-service.xml"],
    srcs: ["health/aidl/default/service.cpp"],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        // "android.hardware.health.intel-V1-ndk",  // Commented out temporarily
        "android.hardware.health.intel-impl",
    ],
    cflags: [
        "-Werror",
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    compile_multilib: "64",
    arch: {
        arm64: {
            enabled: false,
        },
    },
}

prebuilt_etc {
    name: "android.hardware.health.intel-service.rc",
    src: "health/aidl/default/android.hardware.health.intel-service.rc",
    sub_dir: "etc/init",
    vendor: true,
}

prebuilt_etc {
    name: "android.hardware.health.intel-service.xml",
    src: "health/aidl/default/android.hardware.health.intel-service.xml",
    sub_dir: "etc/vintf/manifest",
    vendor: true,
}

